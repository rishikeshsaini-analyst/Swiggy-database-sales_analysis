--TOP_10 CITIES BY ORDER VOLUME
select 
top 10 
dl.City , 
count(f.order_id) as counts_id
from fact_swiggy_orders as f join 
dim_location as dl on dl.location_id=f.location_id
group by City 
order by count(f.order_id) desc

