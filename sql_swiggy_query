--DELETE DUBLICATION 
begin transaction ;
WITH DUBLICATE_RECORD AS (select ROW_NUMBER()OVER(
PARTITION BY State,City,Restaurant_Name,Location,Dish_Name,Price_INR,Rating,Rating_Count order by (select null))
as total_count
from Swiggy_Data)
DELETE FROM 
DUBLICATE_RECORD 
where total_count>1
rollback ;

