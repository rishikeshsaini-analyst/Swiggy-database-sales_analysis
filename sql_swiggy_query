-- fact_table
insert into fact_swiggy_orders
(
dd.date_id,
s.Price_INR,
s.Rating,
s.Rating_Count,
dl.location_id,
dr.restaurant_id,
dc.category_id,
ds.dish_id
)
select dd.date_id ,
 s.Price_INR,
 s.Rating,
 s.Rating_Count,

 dl.location_id,
 dr.restaurant_id,
 dc.category_id,
 ds.dish_id 

 from Swiggy_Data as s 
 join  dim_date as dd
 on dd.FULL_DATE=s.Order_Date

 join dim_location as dl 
 on dl.State = s.State
 and dl.City = s.City
 and dl.Loaction =s.Location

 join dim_category as dc
 on dc.Category = s.Category


 join dim_restaurant as dr 
 on dr.Restaurant_Name = s.Restaurant_Name


 join dim_dish as ds
 on ds.Dish_Name = s.Dish_Name
 
